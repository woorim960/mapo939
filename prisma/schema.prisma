generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceStatus {
  PRESENT
  LATE
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessions AdminSession[]

  @@map("admins")
}

model Member {
  id        String   @id @default(uuid())
  name      String
  birthDate DateTime
  phone     String
  photoUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]
  bonusPoints BonusPoints[]

  @@index([isActive, birthDate])
  @@map("members")
}

model Attendance {
  id        String           @id @default(uuid())
  memberId  String
  date      DateTime
  status    AttendanceStatus
  points    Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, date])
  @@index([date])
  @@index([memberId, date])
  @@map("attendance")
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model BonusPoints {
  id        String   @id @default(uuid())
  memberId  String
  points    Int
  reason    String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([memberId, createdAt])
  @@map("bonus_points")
}

model LiarGame {
  id        String   @id @default(uuid())
  name      String?
  version   Int      @default(0)
  stateJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players LiarPlayer[]

  @@index([createdAt])
  @@index([updatedAt])
}

model LiarPlayer {
  id        String   @id // uuid
  gameId    String
  nickname  String
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game LiarGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, nickname])
  @@index([gameId])
  @@index([gameId, score])
}

model WatermelonPlayer {
  id           String   @id @default(uuid())
  nickname     String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scores    WatermelonScore[]
  items     WatermelonPlayerItem[]
  payments  WatermelonPayment[]
  purchases WatermelonItemPurchase[]

  @@map("watermelon_players")
}

model WatermelonScore {
  id        String   @id @default(uuid())
  playerId  String
  score     Int
  maxTier   Int? // 최대 과일 레벨
  createdAt DateTime @default(now())

  player WatermelonPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([playerId, score])
  @@index([score])
  @@index([createdAt])
  @@map("watermelon_scores")
}

// 아이템 정의
model WatermelonItem {
  id          String   @id @default(uuid())
  name        String // 아이템 이름
  description String? // 설명
  price       Int // 가격 (원)
  effectType  String // 효과 타입 (예: "extra_life", "slow_gravity", "bonus_score", "remove_fruits")
  effectValue Json? // 효과 값 (JSON)
  icon        String? // 아이콘 이모지
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0) // 정렬 순서
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  playerItems WatermelonPlayerItem[]
  purchases   WatermelonItemPurchase[]
  payments    WatermelonPayment[]

  @@index([isActive, sortOrder])
  @@map("watermelon_items")
}

// 플레이어의 아이템 보유량
model WatermelonPlayerItem {
  id        String   @id @default(uuid())
  playerId  String
  itemId    String
  quantity  Int      @default(0) // 보유 개수
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player WatermelonPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item   WatermelonItem   @relation(fields: [itemId], references: [id])

  @@unique([playerId, itemId])
  @@index([playerId])
  @@map("watermelon_player_items")
}

// 결제 내역
model WatermelonPayment {
  id            String   @id @default(uuid())
  playerId      String
  itemId        String?
  amount        Int // 결제 금액
  paymentMethod String // 결제 수단 ("toss", "card", "account" 등)
  paymentKey    String? // 토스페이먼츠 결제 키
  orderId       String? @unique // 주문 ID (unique로 변경)
  status        String // "pending", "completed", "failed", "refunded"
  metadata      Json? // 추가 정보 (결제 상세 정보)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  player   WatermelonPlayer        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item     WatermelonItem?         @relation(fields: [itemId], references: [id])
  purchase WatermelonItemPurchase?

  @@index([playerId])
  @@index([paymentKey])
  @@index([status])
  @@map("watermelon_payments")
}

// 아이템 구매 내역
model WatermelonItemPurchase {
  id        String   @id @default(uuid())
  playerId  String
  itemId    String
  quantity  Int
  paymentId String?  @unique // 결제 ID (1:1 관계)
  createdAt DateTime @default(now())

  player  WatermelonPlayer   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  item    WatermelonItem     @relation(fields: [itemId], references: [id])
  payment WatermelonPayment? @relation(fields: [paymentId], references: [id])

  @@index([playerId])
  @@index([itemId])
  @@index([paymentId])
  @@map("watermelon_item_purchases")
}
