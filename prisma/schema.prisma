generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AttendanceStatus {
  PRESENT
  LATE
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessions AdminSession[]

  @@map("admins")
}

model Member {
  id        String   @id @default(uuid())
  name      String
  birthDate DateTime
  phone     String
  photoUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]
  bonusPoints BonusPoints[]

  @@index([isActive, birthDate])
  @@map("members")
}

model Attendance {
  id        String           @id @default(uuid())
  memberId  String
  date      DateTime
  status    AttendanceStatus
  points    Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, date])
  @@index([date])
  @@index([memberId, date])
  @@map("attendance")
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model BonusPoints {
  id        String   @id @default(uuid())
  memberId  String
  points    Int
  reason    String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([memberId, createdAt])
  @@map("bonus_points")
}

model LiarGame {
  id        String   @id @default(uuid())
  name      String?
  version   Int      @default(0)
  stateJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players LiarPlayer[]

  @@index([createdAt])
  @@index([updatedAt])
}

model LiarPlayer {
  id        String   @id // uuid
  gameId    String
  nickname  String
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game LiarGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, nickname])
  @@index([gameId])
  @@index([gameId, score])
}

model WatermelonPlayer {
  id        String   @id @default(uuid())
  nickname  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores WatermelonScore[]

  @@map("watermelon_players")
}

model WatermelonScore {
  id        String   @id @default(uuid())
  playerId  String
  score     Int
  maxTier   Int?     // 최대 과일 레벨
  createdAt DateTime @default(now())

  player WatermelonPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([playerId, score])
  @@index([score])
  @@index([createdAt])
  @@map("watermelon_scores")
}
