{
  "name": "attendance-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:prod": "NODE_ENV=production next dev",
    "build": "npm run db:migrate && npx next build",
    "build:dev": "NODE_ENV=development npx prisma migrate deploy && npx next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:new": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "check:env": "tsx scripts/check-env.ts",
    "db:copy": "tsx scripts/copy-db-data.ts",
    "seed:members": "tsx prisma/seed-members.ts",
    "seed:watermelon-items": "tsx prisma/seed-watermelon-items.ts",
    "deploy:prod": "bash scripts/deploy-vercel.sh prod",
    "deploy:dev": "bash scripts/deploy-vercel.sh dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@tosspayments/tosspayments-sdk": "^2.5.0",
    "@types/matter-js": "^0.20.2",
    "@types/uuid": "^10.0.0",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "matter-js": "^0.20.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.6",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^7.2.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
